# Copy to .env and fill in as needed. .env is gitignored.
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_TRACKING_USER=

# Transport: "stdio" (default, for Claude Desktop/CLI clients) or "streamable-http"
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Log file path (rotated at 10MB, 5 files retained)
LOG_FILE=./logs/hayabusa-mcp.log
